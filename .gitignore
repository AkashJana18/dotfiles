# Environment variables
.env
.env.*

# Logs
*.log

# Unix sockets
*.sock

# Runtime files
session.json

# opencode runtime files (keep package.json for sharing, ignore only generated)
.config/opencode/node_modules/
.config/opencode/bun.lock

# herdr runtime state & self-managed plugins
.config/herdr/.gitignore
.config/herdr/.plugins.lock
.config/herdr/plugins.json
.config/herdr/release-notes.json
.config/herdr/plugins/
.config/herdr/sessions/
.config/herdr/session-snapshots/
.config/herdr/*.sock*
.config/opencode/herdr-tui-session.js
.config/opencode/herdr-opencode/

# sketchybar compiled helper binary (rebuild via make)
.config/sketchybar/helper/helper

# Backup files
.config/herdr/*.bak-*

# OS files
.DS_Store
