# --- Ghostty Configuration 1.2.3 ---

# Theme & Appearance
theme = Zenwritten Dark
background = #000000
background-opacity = 0.6
background-blur-radius = 50
window-colorspace = display-p3
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = always
window-decoration = none

# Optional: makes the padding look uniform on all sides
window-padding-balance = false 
macos-option-as-alt = true

# Window Geometry
window-padding-x = 0
window-padding-y = 0
resize-overlay = never
window-save-state = always

# Font
font-family = "Fira Code Nerd Font"
font-size = 20

# Mouse & Interaction
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
confirm-close-surface = false

# Shell Integration
# Disables cursor/title control but keeps other features like prompt marking
shell-integration-features = no-cursor,sudo,no-title


# Custom Text Inputs
# Fixes potential newline issues in some shells
keybind = shift+enter=text:\n

# Forward cmd chords to herdr's direct (prefix-free) bindings
keybind = super+b=unbind
keybind = super+g=unbind
keybind = super+x=unbind
keybind = super+t=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind

keybind = super+a=unbind

# Toggle background opacity  requires background-opacity < 1, macOS only
keybind = super+o=toggle_background_opacity
